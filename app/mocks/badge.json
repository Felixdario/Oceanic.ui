  "properties": [
    {
      "name": "badgeContent",
      "type": "string",
      "description": "Define o conteúdo do badge"
    },
    {
      "name": "variant",
      "type": "string",
      "description": "Define a aparência do badge",
      "options": ["standard", "dot"]
    },
    {
      "name": "color",
      "type": "string",
      "description": "Define a cor do badge",
      "options": ["primary", "secondary", "error", "warning", "info", "success"]
    },
    {
      "name": "overlap",
      "type": "string",
      "description": "Define como o badge se sobrepõe ao elemento filho",
      "options": ["rectangular", "circular"]
    },
    {
      "name": "children",
      "type": "string",
      "description": "Define o ícone a ser usado dentro do badge",
      "options": ["NotificationsIcon", "MailIcon", "ShoppingCartIcon", "AccountCircleIcon"]
    }
  ],
